  "description": "دال — پلتفرم جامع املاک آنلاین (بدون وابستگی خارجی؛ Node 22+)",
  "type": "commonjs",
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "admin": "node --no-warnings server/cli.js admin",
