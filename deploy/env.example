# نمونه‌ی فایل تنظیمات سرور: آن را به /opt/dal/data/.env کپی کنید (فقط خطوط لازم را نگه دارید)
# بعد از هر تغییر:  sudo systemctl restart dal

# آدرس عمومی سایت (برای لینک‌های اشتراک، QR و نقشه‌ی سایت)
DAL_BASE_URL=https://dal.example.ir
# پشت Caddy یا Nginx هستید؟ (بله)
TRUST_PROXY=1

# ربات بله (برای ایران پیشنهاد می‌شود): هشدار، پشتیبان روزانه، یادآور و گزارش هفتگی مدیر
DAL_BALE_TOKEN=
DAL_BALE_CHAT=
# ربات تلگرام (داخل ایران فیلتر است)
DAL_TG_TOKEN=
DAL_TG_CHAT=

# ساعت یادآور روزانه (به وقت تهران) و روز/ساعت گزارش هفتگی (۶ = شنبه)
DAL_REMIND_HOUR=8
DAL_REPORT_DAY=6
DAL_REPORT_HOUR=9

# عمر آگهی تا انقضا (روز)
DAL_EXPIRE_DAYS=90

# فایل اپ اندروید برای دانلود از /dal.apk (پیش‌فرض: data/dal.apk). یا آدرس بیرونی آن:
# DAL_APK_URL=https://github.com/Moshaverdanial/aaaa/releases/download/android-latest/dal.apk
